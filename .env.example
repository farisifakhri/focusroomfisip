# Database connection string (PostgreSQL - Supabase / Neon / Local PostgreSQL)
# Contoh Supabase: postgresql://postgres.[project]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Contoh Neon: postgresql://[user]:[password]@[endpoint].neon.tech/focus_room?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/focus_room_fisip?schema=public"

# Secret key untuk signing dynamic QR Code
QR_SECRET_KEY="focus-room-uin-fisip-secure-secret-key-2026"

# Next Auth / Secret
NEXTAUTH_SECRET="uin-jakarta-fisip-focus-room-secret"
